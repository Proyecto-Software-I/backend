NODE_ENV=development

PORT=3001
FRONTEND_URL=http://localhost:3000

# Each developer uses their own local PostgreSQL credentials.
# `npm run setup` creates .env interactively when it does not exist.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/legacylift"

AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30

